{{ ansible_managed | comment }}
# llama-swap configuration — rendered from ansible/roles/llama-swap/templates/config.yaml.j2
# Edit defaults/main.yml or host_vars/goudai.yml, then redeploy via the
# llama-swap role. Do not edit this file directly.

healthCheckTimeout: 120

models:
{% for model_id, m in llama_swap_models.items() %}
  "{{ model_id }}":
{% if m.alias is defined %}
    aliases:
      - "{{ m.alias }}"
{% endif %}
{%- if m.cmd is defined %}
    cmd: "{{ m.cmd }}"
{%- else %}
    cmd: "{{ llama_swap_llama_server_binary }} --host 127.0.0.1 --port ${PORT} -hf {{ m.hf }}{% for flag in m.flags | default([]) %} {{ flag }}{% endfor %}"
{%- endif %}
{% if m.ttl is defined %}
    ttl: {{ m.ttl }}
{% endif %}
    env:
      HF_HOME: "{{ llama_swap_hf_cache_dir }}"
      HF_HUB_CACHE: "{{ llama_swap_hf_cache_dir }}/hub"
      LLAMA_LOG_LEVEL: "{{ llama_swap_log_level }}"
{% endfor %}
