{{ ansible_managed | comment }}
# llama-swap configuration — rendered from ansible/roles/llama-swap/templates/config.yaml.j2
# Edit defaults/main.yml or host_vars/goudai.yml, then redeploy via the
# llama-swap role. Do not edit this file directly.

healthCheckTimeout: {{ llama_swap_health_check_timeout | default(120) }}

models:
{% for model_id, m in llama_swap_models.items() %}
{% if model_id in llama_swap_profile_models[llama_swap_profile] %}
  "{{ model_id }}":
{% if m.alias is defined %}
    aliases:
      - "{{ m.alias }}"
{% endif %}
{% if m.cmd is defined %}
{% set rendered_cmd = m.cmd %}
{% else %}
{% set base_cmd = llama_swap_llama_server_binary ~ " --host 127.0.0.1 --port ${PORT} -hf " ~ m.hf %}
{% set flags_str = (m.flags | default([])) | join(" ") %}
{% set rendered_cmd = (base_cmd ~ " " ~ flags_str) if flags_str else base_cmd %}
{% endif %}
    # to_json (not a raw "..." string) because some flag values contain
    # literal double quotes (e.g. --chat-template-kwargs JSON) that would
    # otherwise break this YAML scalar.
    cmd: {{ rendered_cmd | to_json }}
{% if m.ttl is defined %}
    ttl: {{ m.ttl }}
{% endif %}
    # llama-swap expects env as a list of KEY=VALUE strings, not a dict.
    # The Go YAML unmarshaller errors with "cannot unmarshal !!map into
    # []string" if you give it a dict here.
    env:
      - "HF_HOME={{ llama_swap_hf_cache_dir }}"
      - "HF_HUB_CACHE={{ llama_swap_hf_cache_dir }}/hub"
      - "LLAMA_LOG_LEVEL={{ llama_swap_log_level }}"
{% endif %}
{% endfor %}
{% set active_groups = llama_swap_groups if llama_swap_profile == 'normal' else llama_swap_coding_groups | default({}) %}
{% if active_groups %}

# Groups control which models can coexist in VRAM vs. swap each other out.
# - swap: false + exclusive: false → members coexist permanently
# - swap: true + exclusive: true   → only one member at a time, also unloads
#   any model outside the group when activated (default behaviour)
# - persistent: true               → other groups can't unload these members
groups:
{% for group_id, g in active_groups.items() %}
  "{{ group_id }}":
{% if g.persistent is defined %}
    persistent: {{ g.persistent | lower }}
{% endif %}
{% if g.swap is defined %}
    swap: {{ g.swap | lower }}
{% endif %}
{% if g.exclusive is defined %}
    exclusive: {{ g.exclusive | lower }}
{% endif %}
    members:
{% for member in g.members %}
      - "{{ member }}"
{% endfor %}
{% endfor %}
{% endif %}
