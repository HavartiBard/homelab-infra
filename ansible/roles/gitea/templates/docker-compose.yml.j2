version: "3.9"

services:
  gitea-db:
    container_name: "{{ gitea_db_container_name }}"
    image: "{{ gitea_db_image }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ gitea_db_user }}"
      POSTGRES_PASSWORD: "{{ gitea_db_password }}"
      POSTGRES_DB: "{{ gitea_db_name }}"
    volumes:
      - "{{ gitea_db_data_dir }}:/var/lib/postgresql/data:rw"
    networks:
      gitea_net:
        ipv4_address: "{{ gitea_db_ip }}"
    labels:
      net.unraid.docker.icon: "{{ gitea_db_icon }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ gitea_db_user }}"]
      interval: 30s
      timeout: 5s
      retries: 5

  gitea:
    container_name: "{{ gitea_container_name }}"
    image: "{{ gitea_image }}"
    restart: unless-stopped
    depends_on:
      - gitea-db
    environment:
      TZ: "{{ timezone }}"
      GITEA__server__DOMAIN: "{{ gitea_domain }}"
      GITEA__server__ROOT_URL: "{{ gitea_root_url }}"
      GITEA__server__HTTP_PORT: "{{ gitea_http_port }}"
      GITEA__server__SSH_PORT: "{{ gitea_ssh_port }}"
      GITEA__server__SSH_DOMAIN: "{{ gitea_ssh_domain }}"
      GITEA__server__PROTOCOL: "http"
      GITEA__server__OFFLINE_MODE: false
      GITEA__server__DISABLE_REGISTRATION: "{{ 'false' if gitea_registration_enabled else 'true' }}"
      GITEA__server__START_SSH_SERVER: "{{ 'true' if gitea_ssh_enabled else 'false' }}"
      GITEA__database__DB_TYPE: "postgres"
      GITEA__database__HOST: "{{ gitea_db_container_name }}:5432"
      GITEA__database__NAME: "{{ gitea_db_name }}"
      GITEA__database__USER: "{{ gitea_db_user }}"
      GITEA__database__PASSWD: "{{ gitea_db_password }}"
      GITEA__database__SSL_MODE: "{{ gitea_db_ssl_mode }}"
      GITEA_ADMIN_USER: "{{ gitea_admin_user }}"
      GITEA_ADMIN_PASSWORD: "{{ gitea_admin_password }}"
      GITEA_ADMIN_EMAIL: "{{ gitea_admin_email }}"
      GITEA__security__INSTALL_LOCK: true
      GITEA__service__REGISTER_EMAIL_CONFIRM: false
      GITEA__registry__ENABLED: "{{ 'true' if gitea_registry_enabled else 'false' }}"
      GITEA__registry__HOST: "{{ gitea_registry_host }}"
      GITEA__registry__PORT: "{{ gitea_registry_port }}"
      GITEA__registry__HTTP_PORT: "{{ gitea_registry_port }}"
      GITEA__registry__PATH: "{{ gitea_registry_path }}"
      GITEA__registry__PROTOCOL: "{{ gitea_registry_protocol }}"
    volumes:
      - "{{ gitea_data_dir }}:/data:rw"
      - "{{ gitea_registry_root }}:/data/registry:rw"
    networks:
      gitea_net:
        ipv4_address: "{{ gitea_ip }}"
    labels:
      net.unraid.docker.icon: "{{ gitea_icon }}"
      net.unraid.docker.webui: "{{ gitea_webui_url }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsSL http://{{ gitea_ip }}:{{ gitea_http_port }}/ >/dev/null || exit 1"]
      interval: "{{ gitea_health_interval }}s"
      timeout: "{{ gitea_health_interval }}s"
      retries: {{ gitea_health_attempts }}

networks:
  gitea_net:
    external: true
    name: "{{ gitea_network_name }}"
