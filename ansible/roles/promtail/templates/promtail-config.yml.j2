server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  # Persisted via bind mount — /tmp would lose read positions on container
  # recreation (duplicate/skipped log segments in Loki).
  filename: /positions/positions.yaml

clients:
  - url: {{ loki_url }}/loki/api/v1/push

scrape_configs:

  # Docker container logs (all Docker hosts)
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        target_label: container
      - source_labels: ['__meta_docker_container_id']
        target_label: container_id
      - replacement: {{ inventory_hostname }}
        target_label: host
      - replacement: docker
        target_label: job
    pipeline_stages:
      - drop:
          expression: '\n'
          drop_counter_reason: multiline_docker_entry
      # ComfyUI-specific labels. job_status/level are low-cardinality (a
      # handful of values) so they're safe as indexed Loki labels. prompt_id
      # is deliberately NOT extracted here - it's unique per job and would
      # fragment the stream index; it's available instead via the
      # comfyui_exporter Prometheus metrics (ansible/files/comfyui-exporter).
      # The exact ComfyUI log strings below are best-effort from ComfyUI's
      # known source and unverified against live output - adjust if they
      # don't match what `docker logs comfyui` actually prints.
      - match:
          selector: '{container="comfyui"} |= "got prompt"'
          stages:
            - static_labels:
                job_status: started
      - match:
          selector: '{container="comfyui"} |= "Prompt executed in"'
          stages:
            - static_labels:
                job_status: completed
      - match:
          selector: '{container="comfyui"} |= "Exception during processing"'
          stages:
            - static_labels:
                job_status: error
      - match:
          selector: '{container="comfyui"}'
          stages:
            - static_labels:
                service: comfyui
            - regex:
                expression: '(?i)(?P<level>debug|info|warning|error|critical)'
            - template:
                source: level
                template: "{% raw %}{{ if .level }}{{ .level | lower }}{{ else }}info{{ end }}{% endraw %}"
            - labels:
                level:

{% if not promtail_unraid_mode and promtail_scrape_journal %}
  # Systemd journal (all Linux hosts except Unraid)
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: journal
        host: {{ inventory_hostname }}
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
    pipeline_stages:
      - drop:
          expression: '\n'
          drop_counter_reason: multiline_journal_entry
      - match:
          selector: '{host="{{ inventory_hostname }}"} |~ "(?i)(global oom|oom-kill|out of memory|killed process)"'
          stages:
            - metrics:
                homelab_kernel_oom_events_total:
                  type: Counter
                  description: "Kernel OOM events observed in the systemd journal."
                  config:
                    action: inc
      - match:
          selector: '{host="{{ inventory_hostname }}"} |~ "(?i)(fence fallback timer expired|amdgpu.*fence|queue eviction|kfd.*svm)"'
          stages:
            - metrics:
                homelab_amdgpu_fence_timeout_events_total:
                  type: Counter
                  description: "AMD GPU fence timeout, queue eviction, or KFD/SVM recovery events observed in the systemd journal."
                  config:
                    action: inc
{% endif %}

{% if promtail_adguard_log_path %}
  # AdGuard Home query logs
  - job_name: adguard-queries
    static_configs:
      - targets:
          - localhost
        labels:
          job: adguard
          host: {{ inventory_hostname }}
          __path__: {{ promtail_adguard_log_path }}
{% endif %}

{% if promtail_npm_log_path %}
  # Nginx Proxy Manager file logs (per-proxy-host access/error + letsencrypt).
  # NPM rotates these itself; *.log excludes the rotated .gz archives.
  - job_name: npm
    static_configs:
      - targets:
          - localhost
        labels:
          job: npm
          host: {{ inventory_hostname }}
          __path__: {{ promtail_npm_log_path }}/*.log
{% endif %}

{% if promtail_technitium_log_path %}
  # Technitium DNS query logs
  - job_name: technitium-queries
    static_configs:
      - targets:
          - localhost
        labels:
          job: technitium
          host: {{ inventory_hostname }}
          __path__: {{ promtail_technitium_log_path }}
{% endif %}
