# LLM Backend
LLM_BACKEND=ollama
OLLAMA_BASE_URL={{ ironclaw_ollama_base_url }}
OLLAMA_MODEL={{ ironclaw_ollama_model }}

# Database (resolved via Docker network)
DATABASE_URL=postgres://ironclaw:{{ ironclaw_pg_password }}@{{ ironclaw_postgres_container }}:5432/ironclaw

# HTTP Server (webhook channel — separate from web UI gateway)
HTTP_HOST=0.0.0.0
HTTP_PORT=3001

# Web UI gateway (must be on a different port from HTTP_PORT)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

# Webhook
HTTP_WEBHOOK_SECRET={{ ironclaw_http_webhook_secret }}

# Slack
SLACK_BOT_TOKEN={{ ironclaw_slack_bot_token }}
SLACK_APP_TOKEN={{ ironclaw_slack_app_token }}
SLACK_SIGNING_SECRET={{ ironclaw_slack_signing_secret }}

# Agent
AGENT_NAME={{ ironclaw_agent_name }}
AGENT_MAX_PARALLEL_JOBS={{ ironclaw_agent_max_parallel_jobs }}

# Skip interactive setup wizard and disable REPL (Docker/CI mode)
ONBOARD_COMPLETED=true
SECRETS_MASTER_KEY={{ ironclaw_secrets_master_key }}
CLI_ENABLED=false

# Misc
TZ={{ timezone }}
RUST_LOG=ironclaw=info
