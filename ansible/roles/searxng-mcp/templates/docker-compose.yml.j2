services:
  searxng:
    image: "{{ searxng_image }}"
    container_name: searxng
    restart: unless-stopped
    environment:
      TZ: America/Phoenix
    volumes:
      - "{{ searxng_mcp_appdata }}/searxng:/etc/searxng"
    ports:
      - "{{ searxng_http_port }}:8080"
    networks:
      - searxng-net
    deploy:
      resources:
        limits:
          memory: 512m
          cpus: "1.0"

  mcp-searxng:
    image: "{{ searxng_mcp_image }}"
    container_name: mcp-searxng
    restart: unless-stopped
    labels:
      net.unraid.docker.icon: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/searxng.png"
      net.unraid.docker.webui: "http://192.168.20.14:{{ searxng_mcp_port }}"
    environment:
      TZ: America/Phoenix
      MCP_HTTP_PORT: "3000"
      # v1.3.3+ binds 127.0.0.1 by default, which breaks the published port.
      # 0.0.0.0 is safe here — exposure is governed by the port mapping.
      MCP_HTTP_HOST: "0.0.0.0"
      SEARXNG_URL: "http://searxng:8080"
    ports:
      - "{{ searxng_mcp_port }}:3000"
    networks:
      - searxng-net
    deploy:
      resources:
        limits:
          memory: 256m
          cpus: "0.5"

networks:
  searxng-net:
    driver: bridge
