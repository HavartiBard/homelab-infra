services:
  hister-archive-mcp:
    image: "{{ hister_archive_mcp_image }}"
    container_name: {{ hister_archive_mcp_container_name }}
    restart: unless-stopped
    labels:
      net.unraid.docker.icon: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/search.png"
      net.unraid.docker.webui: "http://192.168.20.14:{{ hister_archive_mcp_port }}/mcp"
    environment:
      TZ: America/Phoenix
      HISTER_URL: "{{ hister_archive_mcp_hister_url }}"
    ports:
      - "{{ hister_archive_mcp_port }}:3000"
    networks:
      - hister-archive-mcp-net
    deploy:
      resources:
        limits:
          memory: 256m
          cpus: "0.5"

networks:
  hister-archive-mcp-net:
    driver: bridge
    ipam:
      config:
        - subnet: {{ hister_archive_mcp_net_subnet }}
