version: '3.8'

services:
  couchdb:
    image: couchdb:{{ couchdb_version }}
    container_name: {{ couchdb_container_name }}
    environment:
      - TZ={{ timezone | default('America/Phoenix') }}
      - COUCHDB_USER={{ couchdb_admin_user }}
      - COUCHDB_PASSWORD={{ couchdb_admin_password }}
    ports:
      - "{{ couchdb_port }}:5984"
    volumes:
      - {{ couchdb_data_dir }}:/opt/couchdb/data
      - {{ couchdb_config_dir }}:/opt/couchdb/etc/local.d
    labels:
      net.unraid.docker.icon: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/couchdb.png"
      net.unraid.docker.webui: "http://{{ ansible_host }}:{{ couchdb_port }}/_utils"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5984/_up"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - homelab

networks:
  homelab:
    external: true
