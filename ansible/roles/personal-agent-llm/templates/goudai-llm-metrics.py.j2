#!/usr/bin/env python3
import json
import os
import subprocess
import tempfile
import time
import urllib.error
import urllib.request

TEXTFILE_DIR = "{{ node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile_collector') }}"
OUT = os.path.join(TEXTFILE_DIR, "goudai_llm.prom")
LLAMA_URL = "http://127.0.0.1:{{ personal_agent_llm_port }}/v1/models"
OLLAMA_PS_URL = "http://127.0.0.1:11434/api/ps"
OLLAMA_TAGS_URL = "http://127.0.0.1:11434/api/tags"
HF_CACHE_DIR = "{{ personal_agent_llm_cache_dir }}"

{% raw %}

def escape_label(value):
    return str(value).replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def metric(name, value, labels=None):
    labels = labels or {}
    if labels:
        rendered = ",".join(f'{key}="{escape_label(val)}"' for key, val in sorted(labels.items()))
        return f"{name}{{{rendered}}} {value}"
    return f"{name} {value}"


def get_json(url, timeout=3):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return response.status, json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return 0, None


def service_active(name):
    result = subprocess.run(
        ["systemctl", "is-active", "--quiet", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 1 if result.returncode == 0 else 0


def dir_size(path):
    total = 0
    if not os.path.exists(path):
        return 0
    for root, _, files in os.walk(path):
        for filename in files:
            full_path = os.path.join(root, filename)
            try:
                total += os.path.getsize(full_path)
            except OSError:
                pass
    return total


def download_progress(path):
    count = 0
    total = 0
    if not os.path.exists(path):
        return count, total
    for root, _, files in os.walk(path):
        for filename in files:
            if filename.endswith(".downloadInProgress"):
                count += 1
                try:
                    total += os.path.getsize(os.path.join(root, filename))
                except OSError:
                    pass
    return count, total


def main():
    now = int(time.time())
    lines = [
        "# HELP goudai_llm_scrape_timestamp_seconds Unix timestamp for this custom scrape.",
        "# TYPE goudai_llm_scrape_timestamp_seconds gauge",
        metric("goudai_llm_scrape_timestamp_seconds", now),
        "# HELP goudai_llm_service_up Whether the host service is active according to systemd.",
        "# TYPE goudai_llm_service_up gauge",
        metric("goudai_llm_service_up", service_active("personal-agent-llm"), {"service": "personal-agent-llm"}),
        metric("goudai_llm_service_up", service_active("ollama"), {"service": "ollama"}),
    ]

    status, llama_payload = get_json(LLAMA_URL)
    lines.extend([
        "# HELP goudai_llm_endpoint_up Whether an LLM API endpoint responded successfully.",
        "# TYPE goudai_llm_endpoint_up gauge",
        metric("goudai_llm_endpoint_up", 1 if status == 200 else 0, {"service": "personal-agent-llm", "api": "openai"}),
    ])
    if isinstance(llama_payload, dict):
        for item in llama_payload.get("data", []):
            model_id = item.get("id", "unknown")
            lines.append(metric("goudai_llm_model_loaded", 1, {"service": "personal-agent-llm", "model": model_id}))

    status, ollama_ps = get_json(OLLAMA_PS_URL)
    lines.append(metric("goudai_llm_endpoint_up", 1 if status == 200 else 0, {"service": "ollama", "api": "ollama"}))
    if isinstance(ollama_ps, dict):
        for item in ollama_ps.get("models", []):
            model_id = item.get("name") or item.get("model") or "unknown"
            lines.append(metric("goudai_llm_model_loaded", 1, {"service": "ollama", "model": model_id}))
            size = item.get("size_vram") or item.get("size") or 0
            lines.append(metric("goudai_llm_model_memory_bytes", int(size), {"service": "ollama", "model": model_id}))

    status, ollama_tags = get_json(OLLAMA_TAGS_URL)
    if isinstance(ollama_tags, dict):
        lines.append(metric("goudai_llm_model_available_total", len(ollama_tags.get("models", [])), {"service": "ollama"}))

    in_progress_count, in_progress_bytes = download_progress(HF_CACHE_DIR)
    lines.extend([
        "# HELP goudai_llm_hf_cache_bytes Size of the personal-agent Hugging Face cache.",
        "# TYPE goudai_llm_hf_cache_bytes gauge",
        metric("goudai_llm_hf_cache_bytes", dir_size(HF_CACHE_DIR), {"service": "personal-agent-llm"}),
        "# HELP goudai_llm_hf_download_in_progress Number of incomplete Hugging Face downloads.",
        "# TYPE goudai_llm_hf_download_in_progress gauge",
        metric("goudai_llm_hf_download_in_progress", in_progress_count, {"service": "personal-agent-llm"}),
        "# HELP goudai_llm_hf_download_in_progress_bytes Bytes currently present in incomplete Hugging Face downloads.",
        "# TYPE goudai_llm_hf_download_in_progress_bytes gauge",
        metric("goudai_llm_hf_download_in_progress_bytes", in_progress_bytes, {"service": "personal-agent-llm"}),
    ])

    os.makedirs(TEXTFILE_DIR, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=TEXTFILE_DIR, delete=False) as tmp:
        tmp.write("\n".join(lines))
        tmp.write("\n")
        tmp_name = tmp.name
    os.chmod(tmp_name, 0o644)
    os.replace(tmp_name, OUT)


if __name__ == "__main__":
    main()
