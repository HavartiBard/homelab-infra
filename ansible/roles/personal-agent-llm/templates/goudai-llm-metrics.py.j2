def escape_label(value):
    return str(value).replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def metric(name, value, labels=None):
    labels = labels or {}
    if labels:
        rendered = ",".join(f'{key}="{escape_label(val)}"' for key, val in sorted(labels.items()))
        return f"{name}{{{rendered}}} {value}"
    return f"{name} {value}"


def get_json(url, timeout=3):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return response.status, json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return 0, None


def get_text(url, timeout=3):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return response.status, response.read().decode("utf-8")
    except (urllib.error.URLError, TimeoutError, UnicodeDecodeError):
        return 0, None


def metric_value(payload, name):
    """Read an unlabeled Prometheus sample from a llama.cpp /metrics body."""
    pattern = re.compile(r"^" + re.escape(name) + r"(?:\{[^}]*\})?\s+([^\s]+)$", re.MULTILINE)
    match = pattern.search(payload or "")
    if not match:
        return None
    try:
        return float(match.group(1))
    except ValueError:
        return None


def service_active(name):
    result = subprocess.run(
        ["systemctl", "is-active", "--quiet", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 1 if result.returncode == 0 else 0


def dir_size(path):
    total = 0
    if not os.path.exists(path):
        return 0
    for root, _, files in os.walk(path):
        for filename in files:
            full_path = os.path.join(root, filename)
            try:
                total += os.path.getsize(full_path)
            except OSError:
                pass
    return total


def download_progress(path):
    count = 0
    total = 0
    if not os.path.exists(path):
        return count, total
    for root, _, files in os.walk(path):
        for filename in files:
            if filename.endswith(".downloadInProgress"):
                count += 1
                try:
                    total += os.path.getsize(os.path.join(root, filename))
                except OSError:
                    pass
    return count, total


def read_gpu_sysfs():
    """Read AMD GPU metrics from kernel sysfs.

    Discovers the GPU card dynamically (card0, card1, etc.) and reads
    VRAM/GTT memory usage and GPU busy percentage. Returns a dict with
    keys: vram_used, vram_total, gtt_used, gtt_total, busy_percent.
    Returns empty dict if sysfs paths are unavailable.
    """
    base = None
    drm = "/sys/class/drm"
    for entry in sorted(os.listdir(drm)):
        if not entry.startswith("card"):
            continue
        busy_path = os.path.join(drm, entry, "device", "gpu_busy_percent")
        if os.path.exists(busy_path):
            base = os.path.join(drm, entry, "device")
            break
    if base is None:
        return {}

    result = {}
    for key, filename in [
        ("vram_used", "mem_info_vram_used"),
        ("vram_total", "mem_info_vram_total"),
        ("gtt_used", "mem_info_gtt_used"),
        ("gtt_total", "mem_info_gtt_total"),
        ("busy_percent", "gpu_busy_percent"),
    ]:
        try:
            with open(os.path.join(base, filename)) as f:
                result[key] = int(f.read().strip())
        except (OSError, ValueError):
            pass

    # Read AMD GPU temperature + power from hwmon (amdgpu driver exposes one
    # hwmon directory under the card's device path).
    hwmon_dir = os.path.join(base, "hwmon")
    if os.path.isdir(hwmon_dir):
        for hw in sorted(os.listdir(hwmon_dir)):
            sensor = os.path.join(hwmon_dir, hw)
            try:
                with open(os.path.join(sensor, "name")) as f:
                    if f.read().strip() != "amdgpu":
                        continue
            except OSError:
                continue
            try:
                with open(os.path.join(sensor, "temp1_input")) as f:
                    # Kernel reports millidegrees Celsius.
                    result["temp_edge_celsius"] = int(f.read().strip()) / 1000.0
            except (OSError, ValueError):
                pass
            try:
                with open(os.path.join(sensor, "power1_average")) as f:
                    # Kernel reports microwatts.
                    result["power_watts"] = int(f.read().strip()) / 1_000_000.0
            except (OSError, ValueError):
                pass
            break
    return result


def read_cpu_temp():
    """Read CPU package temperature from k10temp hwmon (AMD Ryzen)."""
    for entry in sorted(os.listdir("/sys/class/hwmon")):
        sensor = os.path.join("/sys/class/hwmon", entry)
        try:
            with open(os.path.join(sensor, "name")) as f:
                if f.read().strip() != "k10temp":
                    continue
        except OSError:
            continue
        try:
            with open(os.path.join(sensor, "temp1_input")) as f:
                return int(f.read().strip()) / 1000.0
        except (OSError, ValueError):
            return None
    return None


def main():
    now = int(time.time())
    lines = [
        "# HELP goudai_llm_scrape_timestamp_seconds Unix timestamp for this custom scrape.",
        "# TYPE goudai_llm_scrape_timestamp_seconds gauge",
        metric("goudai_llm_scrape_timestamp_seconds", now),
        "# HELP goudai_llm_service_up Whether the host service is active according to systemd.",
        "# TYPE goudai_llm_service_up gauge",
        metric("goudai_llm_service_up", service_active("personal-agent-llm"), {"service": "personal-agent-llm"}),
        metric("goudai_llm_service_up", service_active("llama-swap"), {"service": "llama-swap"}),
        metric("goudai_llm_service_up", service_active("ollama"), {"service": "ollama"}),
        "# HELP goudai_llm_generation_tokens_per_second Average generation throughput reported by llama.cpp.",
        "# TYPE goudai_llm_generation_tokens_per_second gauge",
        "# HELP goudai_llm_prompt_tokens_per_second Average prompt throughput reported by llama.cpp.",
        "# TYPE goudai_llm_prompt_tokens_per_second gauge",
    ]

    status, llama_payload = get_json(LLAMA_URL)
    lines.extend([
        "# HELP goudai_llm_endpoint_up Whether an LLM API endpoint responded successfully.",
        "# TYPE goudai_llm_endpoint_up gauge",
        metric("goudai_llm_endpoint_up", 1 if status == 200 else 0, {"service": "personal-agent-llm", "api": "openai"}),
        metric("goudai_llm_endpoint_up", 1 if status == 200 else 0, {"service": "llama-swap", "api": "openai"}),
    ])
    if isinstance(llama_payload, dict):
        for item in llama_payload.get("data", []):
            model_id = item.get("id", "unknown")
            lines.append(metric("goudai_llm_model_available", 1, {"service": "llama-swap", "model": model_id}))

    status, llama_running = get_json(LLAMA_RUNNING_URL)
    lines.append(metric("goudai_llm_running_endpoint_up", 1 if status == 200 else 0, {"service": "llama-swap"}))
    if isinstance(llama_running, dict):
        for item in llama_running.get("running", []):
            model_id = item.get("model", "unknown")
            state = item.get("state", "unknown")
            lines.append(metric("goudai_llm_model_loaded", 1, {"service": "llama-swap", "model": model_id, "state": state}))

            # llama-swap exposes its proxy metrics, but llama.cpp's inference
            # metrics live on each dynamically allocated child port. Discover
            # the port from /running and copy the useful gauges into the
            # node_exporter textfile collector with stable model labels.
            proxy = item.get("proxy", "")
            port_match = re.search(r":(\d+)(?:/|$)", proxy)
            if not port_match or state != "ready":
                continue
            metrics_status, child_metrics = get_text(
                "http://127.0.0.1:%s/metrics" % port_match.group(1)
            )
            if metrics_status != 200 or child_metrics is None:
                continue
            for source_name, exported_name in [
                ("llamacpp:predicted_tokens_seconds", "goudai_llm_generation_tokens_per_second"),
                ("llamacpp:prompt_tokens_seconds", "goudai_llm_prompt_tokens_per_second"),
            ]:
                value = metric_value(child_metrics, source_name)
                if value is not None and math.isfinite(value):
                    lines.append(metric(exported_name, value, {"service": "llama-swap", "model": model_id}))

    status, ollama_ps = get_json(OLLAMA_PS_URL)
    lines.append(metric("goudai_llm_endpoint_up", 1 if status == 200 else 0, {"service": "ollama", "api": "ollama"}))
    if isinstance(ollama_ps, dict):
        for item in ollama_ps.get("models", []):
            model_id = item.get("name") or item.get("model") or "unknown"
            lines.append(metric("goudai_llm_model_loaded", 1, {"service": "ollama", "model": model_id}))
            size = item.get("size_vram") or item.get("size") or 0
            lines.append(metric("goudai_llm_model_memory_bytes", int(size), {"service": "ollama", "model": model_id}))

    status, ollama_tags = get_json(OLLAMA_TAGS_URL)
    if isinstance(ollama_tags, dict):
        lines.append(metric("goudai_llm_model_available_total", len(ollama_tags.get("models", [])), {"service": "ollama"}))

    in_progress_count, in_progress_bytes = download_progress(HF_CACHE_DIR)
    lines.extend([
        "# HELP goudai_llm_hf_cache_bytes Size of the personal-agent Hugging Face cache.",
        "# TYPE goudai_llm_hf_cache_bytes gauge",
        metric("goudai_llm_hf_cache_bytes", dir_size(HF_CACHE_DIR), {"service": "personal-agent-llm"}),
        "# HELP goudai_llm_hf_download_in_progress Number of incomplete Hugging Face downloads.",
        "# TYPE goudai_llm_hf_download_in_progress gauge",
        metric("goudai_llm_hf_download_in_progress", in_progress_count, {"service": "personal-agent-llm"}),
        "# HELP goudai_llm_hf_download_in_progress_bytes Bytes currently present in incomplete Hugging Face downloads.",
        "# TYPE goudai_llm_hf_download_in_progress_bytes gauge",
        metric("goudai_llm_hf_download_in_progress_bytes", in_progress_bytes, {"service": "personal-agent-llm"}),
    ])

    gpu = read_gpu_sysfs()
    if gpu:
        lines.extend([
            "# HELP goudai_gpu_vram_used_bytes VRAM used by the AMD GPU.",
            "# TYPE goudai_gpu_vram_used_bytes gauge",
            metric("goudai_gpu_vram_used_bytes", gpu.get("vram_used", 0)),
            "# HELP goudai_gpu_vram_total_bytes Total VRAM available on the AMD GPU.",
            "# TYPE goudai_gpu_vram_total_bytes gauge",
            metric("goudai_gpu_vram_total_bytes", gpu.get("vram_total", 0)),
            "# HELP goudai_gpu_gtt_used_bytes GTT memory used by the AMD GPU.",
            "# TYPE goudai_gpu_gtt_used_bytes gauge",
            metric("goudai_gpu_gtt_used_bytes", gpu.get("gtt_used", 0)),
            "# HELP goudai_gpu_gtt_total_bytes Total GTT memory available on the AMD GPU.",
            "# TYPE goudai_gpu_gtt_total_bytes gauge",
            metric("goudai_gpu_gtt_total_bytes", gpu.get("gtt_total", 0)),
            "# HELP goudai_gpu_busy_percent AMD GPU busy percentage.",
            "# TYPE goudai_gpu_busy_percent gauge",
            metric("goudai_gpu_busy_percent", gpu.get("busy_percent", 0)),
        ])
        if "temp_edge_celsius" in gpu:
            lines.extend([
                "# HELP goudai_gpu_temperature_celsius AMD GPU edge temperature.",
                "# TYPE goudai_gpu_temperature_celsius gauge",
                metric("goudai_gpu_temperature_celsius", gpu["temp_edge_celsius"]),
            ])
        if "power_watts" in gpu:
            lines.extend([
                "# HELP goudai_gpu_power_watts AMD GPU average package power.",
                "# TYPE goudai_gpu_power_watts gauge",
                metric("goudai_gpu_power_watts", gpu["power_watts"]),
            ])

    cpu_temp = read_cpu_temp()
    if cpu_temp is not None:
        lines.extend([
            "# HELP goudai_cpu_temperature_celsius CPU package temperature (k10temp Tctl).",
            "# TYPE goudai_cpu_temperature_celsius gauge",
            metric("goudai_cpu_temperature_celsius", cpu_temp),
        ])

    os.makedirs(TEXTFILE_DIR, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=TEXTFILE_DIR, delete=False) as tmp:
        tmp.write("\n".join(lines))
        tmp.write("\n")
        tmp_name = tmp.name
    os.chmod(tmp_name, 0o644)
    os.replace(tmp_name, OUT)


if __name__ == "__main__":
    main()
