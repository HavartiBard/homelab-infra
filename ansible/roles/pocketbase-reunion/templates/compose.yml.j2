---
services:
  pocketbase-reunion:
    image: ghcr.io/muchobien/pocketbase:{{ pocketbase_reunion_version }}
    container_name: pocketbase-reunion
    volumes:
      # muchobien image runs `pocketbase serve --dir=/pb_data`; PocketBase reads
      # migrations from the sibling /pb_migrations. Mount targets must match those
      # exact paths or data is not persisted and migrations never apply.
      - {{ pocketbase_reunion_base_dir }}/data:/pb_data
      - {{ pocketbase_reunion_base_dir }}/pb_migrations:/pb_migrations
    ports:
      - "{{ pocketbase_reunion_port }}:8090"
    restart: unless-stopped
    networks:
      - reunion
    healthcheck:
      test: wget -qO- http://localhost:8090/api/health || exit 1
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared-reunion
    command: tunnel --no-autoupdate --config /etc/cloudflared/config.yml run
    volumes:
      - {{ pocketbase_reunion_base_dir }}/cloudflared:/etc/cloudflared:ro
    restart: unless-stopped
    depends_on:
      - pocketbase-reunion
    networks:
      - reunion

networks:
  reunion:
    driver: bridge
