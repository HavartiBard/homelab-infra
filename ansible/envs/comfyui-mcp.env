# Optional external API keys for comfyui-mcp's model-management tools
# (CivitAI/HuggingFace downloads). comfyui-mcp itself is LAN-only, no NPM
# proxy, no bearer token — network isolation is the access control, matching
# icloud-mcp/gitea-mcp/etc. Leave the 1Password fields blank if you don't
# want the download tools to work yet; the sidecar still runs fine without them.
CIVITAI_API_TOKEN=op://AI Wedge/comfyui-mcp/civitai_token
HUGGINGFACE_TOKEN=op://AI Wedge/comfyui-mcp/huggingface_token
