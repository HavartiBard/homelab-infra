# deploy-homepage.yml reads these directly at the play level (via
# group_vars/unraid/unraid.yml) without including the owning roles, so this
# file duplicates references already present in unraid-mcp.env, npm.env,
# proxmox-mcp.env, and adguard.env rather than cross-referencing them.
UNRAID_API_KEY=op://AI Wedge/Unraid GraphQL - Wedge/credential
NPM_ADMIN_EMAIL=op://AI Wedge/Nginx Proxy Manager Admin/username
NPM_ADMIN_PASSWORD=op://AI Wedge/Nginx Proxy Manager Admin/password
PROXMOX_USER=op://AI Wedge/Proxmox MCP Token/username
PROXMOX_TOKEN_NAME=op://AI Wedge/Proxmox MCP Token/token_name
PROXMOX_TOKEN_VALUE=op://AI Wedge/Proxmox MCP Token/credential
ADGUARD_ADMIN_USERNAME=op://AI Wedge/AdGuard Admin/username
ADGUARD_ADMIN_PASSWORD=op://AI Wedge/AdGuard Admin/password
