name: comfyui

# ComfyUI for AMD Strix Halo (Ryzen AI MAX+ 395 / Radeon 8060S, gfx1151) on goudai.
# Base image bundles ROCm 7.2 + PyTorch 2.9.1 + flash-attention (native gfx1151).
# Derived image (comfyui-gfx1151-ltx:local, built from docker/comfyui-gfx1151)
# adds the LTX2_SM python deps and bakes ComfyUI into /opt/ComfyUI. Models, custom
# nodes, output and workflows come from the Unraid NFS share so the model library
# is shared with the rest of the homelab. The whole custom-nodes directory is
# mounted (matching spraycheese) so node packs added to the share show up here
# without editing this template; some CUDA-only packs (e.g. Nvidia_RTX_Nodes)
# will fail to import on ROCm — ComfyUI logs and skips those, it doesn't crash.
services:
  comfyui:
    image: comfyui-gfx1151-ltx:local
    container_name: comfyui
    restart: unless-stopped
    shm_size: 8g
    ports:
      - "8188:8188"
    environment:
      TZ: "America/Phoenix"
      FLASH_ATTENTION_TRITON_AMD_ENABLE: "TRUE"
      TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL: "1"
    command:
      - python3
      - /opt/ComfyUI/main.py
      - --listen
      - 0.0.0.0
      - --port
      - "8188"
      - --use-pytorch-cross-attention
      - --disable-mmap
    volumes:
      - "/mnt/ai-models/comfyui/models:/opt/ComfyUI/models"
      - "/mnt/ai-models/comfyui/input:/opt/ComfyUI/input"
      - "/mnt/ai-models/comfyui/output:/opt/ComfyUI/output"
      - "/mnt/ai-models/comfyui/custom-nodes:/opt/ComfyUI/custom_nodes"
      - "/mnt/ai-models/comfyui/workflows:/opt/ComfyUI/user/default/workflows"
    devices:
      - /dev/kfd
      - /dev/dri
    group_add:
      - "{{ comfyui_video_gid }}"   # video
      - "{{ comfyui_render_gid }}"  # render
    cap_add:
      - SYS_PTRACE
    security_opt:
      - seccomp:unconfined
    networks:
      - comfyui

  comfyui-exporter:
    image: python:3.12-alpine
    container_name: comfyui-exporter
    restart: unless-stopped
    command: ["python3", "/app/comfyui_exporter.py"]
    environment:
      COMFYUI_URL: "http://comfyui:8188"
    ports:
      - "9840:9840"
    volumes:
      - "{{ comfyui_service_dir }}/comfyui_exporter.py:/app/comfyui_exporter.py:ro"
      # Read-only, no devices/privileged needed - just the amdgpu sysfs
      # attributes (gpu_busy_percent, mem_info_vram_*, hwmon temp/power).
      - "/sys:/sys:ro"
    networks:
      - comfyui
    depends_on:
      - comfyui

networks:
  comfyui:
    name: comfyui
