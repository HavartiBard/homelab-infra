services:
  hermes:
    image: {{ hermes_image }}
    container_name: {{ hermes_container_name }}
    restart: unless-stopped
    user: "0"
    entrypoint: ["/bin/sh", "-c", "command -v ssh >/dev/null 2>&1 || (apt-get update -qq && apt-get install -y --no-install-recommends openssh-client); chown -R {{ hermes_uid }}:{{ hermes_gid }} /home/node/.hermes; mkdir -p /opt/data/.ssh && cp /home/node/.hermes/ssh/id_ed25519_homelab /opt/data/.ssh/ 2>/dev/null; cp /home/node/.hermes/ssh/config /opt/data/.ssh/ 2>/dev/null; chown -R {{ hermes_uid }}:{{ hermes_gid }} /opt/data/.ssh; chmod 700 /opt/data/.ssh; chmod 600 /opt/data/.ssh/id_ed25519_homelab 2>/dev/null; /opt/hermes/docker/entrypoint.sh dashboard --port {{ hermes_dashboard_port }} --host 0.0.0.0 --insecure & exec /opt/hermes/docker/entrypoint.sh gateway run"]
    command: []
    network_mode: host
    stdin_open: true
    tty: true
    volumes:
      - {{ hermes_state_dir }}:/home/node/.hermes
    env_file:
      - {{ hermes_env_file }}
    environment:
      - HERMES_HOME=/home/node/.hermes
      - HERMES_UID={{ hermes_uid }}
      - HERMES_GID={{ hermes_gid }}
      - HERMES_DASHBOARD_PORT={{ hermes_dashboard_port }}
