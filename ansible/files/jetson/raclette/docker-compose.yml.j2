services:
  raclette:
    image: {{ raclette_image }}
    container_name: {{ raclette_container_name }}
    restart: unless-stopped
    user: "0"
    # No custom entrypoint: the image is s6-overlay based (ENTRYPOINT
    # [/init, main-wrapper.sh]) — the gateway and dashboard run as
    # s6-supervised services, not as something we exec ourselves.
    # CMD just idles the container's "main program" slot; see
    # docs/plans/2026-05-07-s6-overlay-dynamic-subagent-gateways.md
    # (upstream hermes-agent repo) for the architecture.
    command: ["sleep", "infinity"]
    networks:
      - hermes-core-net
    # Gateway port (raclette_gateway_port) is deliberately NOT published to
    # the host. Docker adds an automatic anti-spoof rule to the raw table's
    # PREROUTING chain for every published container port ("DROP anything
    # to <container-IP> not arriving via <that container's own bridge>") —
    # this runs before DOCKER-USER/FORWARD are ever evaluated, and silently
    # drops routed cross-bridge traffic. This is what was blocking Lyra's
    # (isolated stack, hermes-lyra-net) return traffic on the one-directional
    # carve-out (confirmed 2026-07-24). Publishing only the dashboard port
    # keeps LAN access working while removing the one anti-spoof rule that
    # conflicted with cross-bridge routing.
    ports:
      - "{{ raclette_dashboard_port }}:{{ raclette_dashboard_port }}"
    stdin_open: true
    tty: true
    volumes:
      - {{ raclette_state_dir }}:/home/node/.hermes
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ raclette_deploy_dir }}/ssh-agent-init.sh:/etc/cont-init.d/03-ssh-agent-setup.sh:ro
    env_file:
      - {{ raclette_env_file }}
    environment:
      - HERMES_HOME=/home/node/.hermes
      - HERMES_UID={{ raclette_uid }}
      - HERMES_GID={{ raclette_gid }}
      - HERMES_DASHBOARD_PORT={{ raclette_dashboard_port }}
      - HERMES_DASHBOARD=true
      # Required for Hermes Desktop's remote-gateway /api/ws JSON-RPC socket;
      # the base image doesn't set this. See fathah/hermes-desktop#520.
      - HERMES_DASHBOARD_TUI=1
      - API_SERVER_ENABLED=true
      - API_SERVER_PORT={{ raclette_gateway_port }}
      - API_SERVER_HOST=0.0.0.0
      - API_SERVER_KEY={{ raclette_env.API_SERVER_KEY }}

networks:
  hermes-core-net:
    name: hermes-core-net
    ipam:
      config:
        - subnet: 172.28.10.0/24
