---
proxy_hosts:
  - name: npm-ui
    domains:
      - npm.klsll.com
    forward_host: 192.168.20.50
    forward_port: 81
    scheme: http
    websocket: true
    certificate: klsll-wildcard
    ssl_forced: true
    hsts: true
    http2: true

dns_records:
  - name: npm.klsll.com
    type: A
    value: 192.168.20.50
    ttl: 3600
