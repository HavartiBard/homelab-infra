services:
  litellm:
    image: ghcr.io/berriai/litellm:main-stable
    restart: unless-stopped
    command: ["--port", "4000", "--config", "/app/config.yaml"]
    ports:
      - "4000:4000"
    volumes:
      - /mnt/user/appdata/litellm/config.yaml:/app/config.yaml:ro
    environment:
      LITELLM_MASTER_KEY: "{{ vault_litellm_master_key }}"
    networks:
      - litellm-net

networks:
  litellm-net:
