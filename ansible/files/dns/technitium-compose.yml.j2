---
# Technitium DNS Server - deployed to tt1/tt2 LXCs
# Managed by Ansible: ansible/playbooks/provision-dns-dhcp-services.yml
version: "3.8"
services:
  technitium:
    image: technitium/dns-server:latest
    container_name: technitium
    network_mode: host
    restart: unless-stopped
    environment:
      - DNS_SERVER_DOMAIN=technitium.local
      - DNS_SERVER_ADMIN_PASSWORD=${TECHNITIUM_ADMIN_PASSWORD:?set TECHNITIUM_ADMIN_PASSWORD}
    volumes:
      - ./data/technitium:/etc/dns:rw
    cap_add:
      - NET_ADMIN
    security_opt:
      - apparmor=unconfined
