      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host) (rate(comfyui_prompts_completed_total[5m]))",
          "legendFormat": "{{host}} completed",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host) (rate(comfyui_prompts_errored_total[5m]))",
          "legendFormat": "{{host}} errored",
          "range": true,
          "refId": "B"
        }
