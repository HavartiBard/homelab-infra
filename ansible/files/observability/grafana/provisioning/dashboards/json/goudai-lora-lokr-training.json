  "refresh": "15s",
  "schemaVersion": 40,
  "tags": [
    "goudai",
    "training",
    "lora",
    "lokr"
  ],
  "templating": {
    "list": [
      {
        "name": "training_job",
        "label": "Training job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": {
          "query": "label_values(lora_training_step, training_job)",
          "refId": "VariableQueryEditor-Job"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "instance",
        "label": "Goudai instance",
