      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lora_training_estimated_completion_timestamp_seconds{training_job=~\".+\"} * 1000",
          "range": true
