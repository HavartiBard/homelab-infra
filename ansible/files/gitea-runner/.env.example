# Gitea Runner Environment Variables
# Copy to .env and fill in required values

# ============================================================================
# REQUIRED: Runner Registration Token
# ============================================================================
# Generate at: https://gitea.klsll.com/admin/runners
# Click "Create New Runner" and copy the registration token
# Token is valid for 1 hour, then must be regenerated
GITEA_RUNNER_TOKEN=CHANGEME_gitea_runner_token_here

# ============================================================================
# Gitea Instance Configuration
# ============================================================================
# URL of Gitea instance (must be reachable from runner host)
GITEA_INSTANCE_URL=https://gitea.klsll.com

# ============================================================================
# Registry Configuration (Optional)
# ============================================================================
# For pushing images to private registry
REGISTRY_USERNAME=your_registry_user
REGISTRY_PASSWORD=CHANGEME_your_registry_password
REGISTRY_HOST=registry.klsll.com

# ============================================================================
# GitHub API Token (Optional)
# ============================================================================
# For workflows that need to access GitHub APIs
# E.g., for github-script action or GitHub Packages
GITHUB_TOKEN=CHANGEME_github_token_optional

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================
# Number of concurrent runner containers
GITEA_RUNNER_COUNT=2

# Memory limit per runner (e.g., 4g, 2g)
GITEA_RUNNER_MEMORY_LIMIT=4g

# CPU limit per runner (float)
GITEA_RUNNER_CPUS_LIMIT=2

# Log level (debug, info, warn, error)
GITEA_RUNNER_LOG_LEVEL=info

# Runner labels (comma-separated)
# GITEA_RUNNER_LABELS=ubuntu-latest,linux,docker,x86_64

# Job timeout in minutes
GITEA_RUNNER_JOB_TIMEOUT_MINUTES=120
