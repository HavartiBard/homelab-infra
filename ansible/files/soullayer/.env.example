# SoulLayer MCP Server Configuration

# Data directory (where soul.md and .soullayer/ database live)
SOULLAYER_DATA_DIR=/mnt/user/appdata/soullayer

# Soul file path (your AI's personality)
SOULLAYER_SOUL_FILE=/mnt/user/appdata/soullayer/soul.md

# Port for SSE transport (optional, stdio is default for MCP)
SOULLAYER_PORT=6980

# Timezone
TZ=America/Phoenix

# Optional: Custom icon
SOULLAYER_ICON=https://raw.githubusercontent.com/phoenix0700/soullayer/main/docs/icon.png
