# Monitoring Stack Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - only .env.example

# =============================================================================
# General Settings
# =============================================================================
TZ=America/New_York

# =============================================================================
# Prometheus Settings
# =============================================================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# =============================================================================
# Grafana Settings
# =============================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD resolved from 1Password via op.env, not this file
# (see docs/secrets-management.md). Deploy with:
#   op run --env-file=op.env -- docker compose up -d
GRAFANA_ROOT_URL=http://localhost:3000

# Optional plugins (comma-separated)
GRAFANA_PLUGINS=

# =============================================================================
# Exporter Ports
# =============================================================================
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081
SNMP_EXPORTER_PORT=9116
