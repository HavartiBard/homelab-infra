# Platform Stack Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - only .env.example

# =============================================================================
# General Settings
# =============================================================================
TZ=America/New_York

# =============================================================================
# Portainer Settings
# =============================================================================
PORTAINER_HTTPS_PORT=9443
PORTAINER_HTTP_PORT=9000
PORTAINER_EDGE_PORT=8000

# =============================================================================
# Nginx Proxy Manager Settings
# =============================================================================
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
NPM_DISABLE_IPV6=true

# Database credentials — resolved from 1Password via op.env, not this file
# (see docs/secrets-management.md). Deploy with:
#   op run --env-file=op.env -- docker compose up -d
NPM_DB_USER=npm
NPM_DB_NAME=npm

# =============================================================================
# Uptime Kuma Settings
# =============================================================================
KUMA_PORT=3001

# =============================================================================
# Homepage Settings
# =============================================================================
HOMEPAGE_PORT=3002
HOMEPAGE_PUID=1000
HOMEPAGE_PGID=1000
HOMEPAGE_LOG_LEVEL=info
HOMEPAGE_WEBUI_URL=https://home.klsll.com
HOMEPAGE_ICON=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/homepage.png
