# Environment files (keep .env.example templates)
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# Virtual environments
.venv*/

# IDE/editor configs
.vscode/
.idea/
ide_configs/

# Config files with credentials
docker/*-unraid.env

# Python/Node junk (if needed later)
__pycache__/
*.pyc
node_modules/

# Docker Desktop/Portainer artifacts
*.log

# Ansible vault backups
ansible/group_vars/**/*.bak.*

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Vault files deprecated - using direct 1Password service account lookups
ansible/group_vars/*/vault.yml
ansible/group_vars/*/vault.yml.bak.*
ansible/artifacts/
