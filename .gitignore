# Environment files (keep .env.example templates)
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# Virtual environments
.venv*/

# IDE/editor configs
.vscode/
.idea/
ide_configs/

# Agent/planner artifacts
.sisyphus/
# Config files with credentials
docker/*-unraid.env

# SSH authorized keys (contain public keys specific to each deployment)
docker/dev-environment/config/authorized_keys

# Python/Node junk (if needed later)
__pycache__/
*.pyc
node_modules/

# Docker Desktop/Portainer artifacts
*.log

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
