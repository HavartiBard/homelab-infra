name: observability-smoke

on:
  push:
    branches:
      - '**'
  pull_request:
    branches:
      - '**'

jobs:
  smoke:
    runs-on: ubuntu-latest
    if: false  # Temporarily disabled - waiting for runner configuration
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Static checks (config validation — always)
        run: python3 scripts/test-observability-alerting.py static
      - name: Live checks (requires Unraid stack — push only)
        if: github.event_name == 'push'
        run: python3 scripts/test-observability-alerting.py live --docker-exec
